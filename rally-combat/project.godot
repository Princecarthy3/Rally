config_version=5

[application]

config/name="Rally Combat"
config/description="3D Multiplayer Arena Fighting Game for Rally"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "3D")
config/icon="res://icon.svg"

[display]

